// Postify — data model
// Phase 1 (Foundation): auth, company profile, Brand Kit, Creative DNA
// schema (structure only — the confidence-score learning logic itself is
// Phase 7), Media Library. Phase 2 (AI Content Director) adds
// ProviderCredential for BYOK generation. Phase 3 (Poster Engine) adds
// Poster. Phase 4 (Video Engine) adds Video/VideoScene. Phase 5
// (Campaigns & Calendar) adds Campaign/CampaignItem. Phase 6 (Publishing)
// adds SocialAccount/PublishJob/PublicAssetLink. See CLAUDE.md for the
// full phase plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    CompanyMember[]
  uploadedAssets MediaAsset[]
}

enum CompanyRole {
  OWNER
  MEMBER
}

// A company's locale drives which UI language/typography rules apply.
// English and Arabic are both first-class per CLAUDE.md system #3 — this
// is not "English + a translation flag."
enum Locale {
  EN
  AR
}

model Company {
  id              String   @id @default(cuid())
  // Onboarding is intentionally light in Phase 1: a company just picks a
  // primary industry + free-text secondary niches. Phase 2's industry
  // packs (src/lib/industry-packs.ts) key off primaryIndustry to make
  // these values actually shape generated content.
  name            String
  primaryIndustry String
  secondaryNiches String[] @default([])
  locale          Locale   @default(EN)
  voiceEngine     VoiceEngine @default(FREE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Which of the three campaign-card publish paths this company currently
  // has selected as its default — drives which button set is highlighted
  // in the UI. Manual is the zero-setup default; every company starts here.
  publishingMode     PublishingMode            @default(MANUAL)
  selectedAggregator SocialAggregatorProvider?

  members               CompanyMember[]
  brandKit              BrandKit?
  creativeDna           CreativeDna?
  mediaAssets           MediaAsset[]
  providerCredentials   ProviderCredential[]
  posters               Poster[]
  videos                Video[]
  campaigns             Campaign[]
  socialAccounts        SocialAccount[]
  publishJobs           PublishJob[]
  aggregatorCredentials AggregatorCredential[]
  aggregatorPublishLogs AggregatorPublishLog[]
  engagementSnapshots   EngagementSnapshot[]
}

enum PublishingMode {
  MANUAL // download the file yourself, post it by hand — zero setup, always available
  AGGREGATOR // route through a BYOK social-aggregator adapter (see SocialAggregatorProvider)
  DIRECT_API // publish straight through this app's own Meta Graph API integration
}

// The multi-tenant boundary: every company-scoped query must go through
// a membership check, not a client-supplied companyId. See CLAUDE.md
// non-negotiable #2 (data-layer isolation, not just UI-layer).
model CompanyMember {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole @default(OWNER)
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model BrandKit {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  logoAssetId String?     @unique
  logoAsset   MediaAsset? @relation("BrandKitLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)

  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  fontHeading    String?
  fontBody       String?

  updatedAt DateTime @updatedAt
}

// Structure only for Phase 1. confidenceScores stays an empty object
// until Phase 7 wires up real, evidence-gated learning — CLAUDE.md is
// explicit that preferences must not shift on single-post overfitting,
// so no score-writing code should exist yet.
model CreativeDna {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  toneDescriptors  String[] @default([])
  confidenceScores Json     @default("{}")

  updatedAt DateTime @updatedAt
}

// Auto-tagging in Phase 1 is limited to structural metadata (mime type,
// dimensions, orientation) captured at upload time — no AI involved.
// Semantic tags (subject/objects/people/category) and natural-language
// search require a vision provider, which Phase 2 doesn't add (text
// only — see ProviderCredential/TextProvider). Do not fake those fields
// here until that provider exists.
model MediaAsset {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  storageKey  String  @unique
  fileName    String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  orientation String?

  createdAt DateTime @default(now())

  // Storage-cleanup bookkeeping (cleanupMediaStorage in
  // src/lib/storage-cleanup.ts). The DB row and its metadata/captions are
  // never deleted by cleanup — only the heavy file in storage.storageKey.
  // storageDeletedAt set = the file is gone; callers must check this
  // before calling storage.get(storageKey) and show "no longer available"
  // instead of a broken image/video.
  storageDeletedAt DateTime?
  // Bumped every time a user uses the "Download Asset & Copy Caption"
  // button — counts toward the stale-retention cron's "undownloaded"
  // check, but explicitly NEVER counts as publish confirmation and never
  // triggers cleanupMediaStorage on its own.
  downloadedAt DateTime?
  // Set by the daily retention cron (flag-stale-media) when this asset is
  // older than MEDIA_RETENTION_DAYS with no download and no successful
  // publish. Cleared on download, on successful publish, or when the user
  // clicks "extend retention". The cron only ever sets this flag — it
  // never deletes anything itself.
  staleFlaggedAt DateTime?
  // Bumped when the user clicks "extend retention" on a flagged card —
  // the cron's age check uses max(retentionExtendedAt, createdAt), so an
  // extension genuinely restarts the countdown rather than just hiding
  // the warning.
  retentionExtendedAt DateTime?

  brandKitLogo BrandKit?         @relation("BrandKitLogo")
  posterOutput Poster?           @relation("PosterOutput")
  posterInputs Poster[]          @relation("PosterBackgroundSource")
  videoOutput  Video?            @relation("VideoOutput")
  videoScenes  VideoScene[]
  publicLinks  PublicAssetLink[]

  @@index([companyId])
}

enum AspectRatio {
  SQUARE // 1:1
  STORY // 9:16
  LANDSCAPE // 16:9
}

enum BackgroundSource {
  BRAND // free — gradient rendered from BrandKit colors, no provider call
  PHOTO // real — an existing MediaAsset picked from the Media Library
  AI // BYOK — generated via ImageProvider (Phase 3's gpt-image-1 adapter)
}

// Four real, distinct layouts (src/lib/poster/templates.tsx), not a
// single hardcoded design — MINIMAL/BOLD_HEADLINE composite text over
// the photo with a translucent scrim; PROMOTIONAL_BANNER/SPLIT_PRODUCT
// put text on a solid brand-color panel instead (a stronger, simpler
// contrast guarantee than any overlay — see quality-gate.ts).
enum PosterTemplate {
  MINIMAL
  BOLD_HEADLINE
  PROMOTIONAL_BANNER
  SPLIT_PRODUCT
  MODERN_BANNER
  BADGE_OFFER
  MINIMALIST_FRAME
}

// A rendered poster. The pipeline (src/lib/poster/) always produces a
// real PNG via Satori + resvg — no placeholder/fake output is ever
// saved here. `asset` is that PNG, stored and served through the same
// MediaAsset/storage machinery Phase 1 built (never a separate path).
model Poster {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assetId String     @unique
  asset   MediaAsset @relation("PosterOutput", fields: [assetId], references: [id], onDelete: Cascade)

  headline String
  subhead  String?
  cta      String?

  aspectRatio       AspectRatio
  template          PosterTemplate   @default(MINIMAL)
  backgroundSource  BackgroundSource
  // Only set when backgroundSource is PHOTO or AI-with-a-reference —
  // SetNull rather than Cascade because deleting the source photo
  // shouldn't delete a poster that already baked it into a final PNG.
  backgroundAssetId String?
  backgroundAsset   MediaAsset?      @relation("PosterBackgroundSource", fields: [backgroundAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  campaignItem CampaignItem?
  publishJobs  PublishJob[]

  @@index([companyId])
}

enum CampaignItemStatus {
  PENDING // queued, not yet attempted
  GENERATING // a job is actively working on it
  READY // generated successfully, awaiting review
  FAILED // exhausted retries — needs a manual retry after the underlying issue is fixed
  APPROVED // reviewed and approved by the user
}

// A campaign is a coherent multi-day content plan, not N independent
// generations: generateCampaignPlan produces one set of distinct daily
// angles up front, and each CampaignItem reuses the *existing* poster
// pipeline with its own angle as the topic. Video items are deferred —
// posters only for Phase 5, to prove the job/retry/calendar machinery
// without also carrying video's much longer per-item render time.
model Campaign {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  objective String
  // Free text, not a Prisma enum — SME industries (construction,
  // education, real estate, etc.) need campaign types beyond a fixed
  // set over time, so this stays open rather than hard-coded. The AI
  // Creative Director infers it from the objective (src/lib/campaign/
  // creative-director.ts); never asked of the user as a separate field.
  campaignType String @default("General")

  createdAt DateTime @default(now())

  items CampaignItem[]

  @@index([companyId])
}

// Only the asset types with a real backing renderer — offering
// "carousel" here would be fake functionality, since no carousel
// pipeline exists in this app.
enum CampaignAssetType {
  POSTER
  VIDEO
}

// Background-job bookkeeping lives directly on the row (retryCount,
// nextAttemptAt) rather than a separate generic job-queue table — one
// job type per item (generate this item's poster or video), so a
// dedicated queue abstraction would be premature. See src/lib/jobs/ for
// the processor.
model CampaignItem {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  scheduledDate DateTime
  angle         String // this day's specific sub-topic, from the campaign plan — shown in the calendar UI regardless of asset type
  assetType     CampaignAssetType  @default(POSTER)
  status        CampaignItemStatus @default(PENDING)
  // Incremented on every explicit "Regenerate" click (process-campaign-items.ts).
  // Threaded into which poster template gets used and which auto-selected
  // B-roll assets a video gets, so an explicit regenerate is guaranteed to
  // produce a genuinely different output — the BRAND-gradient poster
  // pipeline and the free-tier script generator are both otherwise fully
  // deterministic given identical inputs.
  generationAttempt Int @default(0)

  // Poster-pipeline inputs (assetType == POSTER). Nullable: falls back
  // to `angle` as the headline for backward compatibility with items
  // created before these fields existed.
  headline String?
  subhead  String?
  cta      String?

  posterId String? @unique
  poster   Poster? @relation(fields: [posterId], references: [id], onDelete: SetNull)
  videoId  String? @unique
  video    Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  // Distribution draft, generated alongside the asset — pre-fills the
  // real Publish form (src/lib/actions/publish.ts) for poster items.
  // Direct Meta Graph API publishing (existing PublishJob/SocialAccount
  // machinery) only ever handles photos, so for video items this is only
  // wired to the aggregator publish path (Zernio supports video media),
  // not Direct API Publish.
  captionText     String?
  hashtags        String[]         @default([])
  // Only ever populated from the company's actually-connected accounts
  // (SocialAccount) — never a platform this app can't really publish
  // to (e.g. TikTok, which has no integration here at all).
  targetPlatforms SocialPlatform[] @default([])
  suggestedPostAt DateTime?

  errorMessage  String?
  retryCount    Int      @default(0)
  nextAttemptAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aggregatorPublishLogs AggregatorPublishLog[]

  @@index([campaignId])
  @@index([status, nextAttemptAt])
}

enum SceneKind {
  REAL_PHOTO
  REAL_VIDEO
  AI_STILL // Phase 3's ImageProvider, used as supplementary B-roll among
  // real media — never the sole technique. True AI-generated *moving*
  // clips (Runway/Luma-style) are an explicitly deferred enhancement,
  // not built here.
}

// Motion presets for the FFmpeg render pipeline (src/lib/video/render.ts)
// — real keyframed ffmpeg overlay filters, evaluated against Remotion
// first and rejected on licensing grounds (see the Task 2 evaluation:
// Remotion's free tier requires a ≤3-employee for-profit org, which
// isn't verifiable for this company). STANDARD is the existing
// scenes+captions+logo pipeline, unchanged.
enum VideoTemplate {
  STANDARD
  LOWER_THIRD_PROMO // slide-in/out banner during the hook and CTA sections
  WAVEFORM_CAPTIONS // real audio-reactive waveform band (ffmpeg showwaves) above the captions
}

// A rendered video. Like Poster, the actual output (`asset`) is a real
// MP4 produced by src/lib/video/ — no placeholder is ever saved here.
// `script` is the structured hook/context/value/message/CTA sections
// used to generate narration and captions, kept for reference/editing,
// not just thrown away after render.
model Video {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assetId String     @unique
  asset   MediaAsset @relation("VideoOutput", fields: [assetId], references: [id], onDelete: Cascade)

  topic        String
  script       Json
  aspectRatio  AspectRatio
  template     VideoTemplate @default(STANDARD)
  // BYOK only (OpenAI TTS + Whisper word timestamps) — the free tier
  // ships without spoken narration. See README.md for why.
  hasNarration Boolean

  scenes VideoScene[]

  createdAt DateTime @default(now())

  campaignItem CampaignItem?

  @@index([companyId])
}

// Provenance of which source media went into a rendered video, in
// order. mediaAsset is nullable + SetNull (not Cascade) because the
// final MP4 already has the footage baked in — losing a source photo's
// DB row shouldn't break a finished video, only its edit history.
model VideoScene {
  id      String @id @default(cuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  order        Int
  kind         SceneKind
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([videoId])
}

enum AiProviderKind {
  OPENAI
  ANTHROPIC
  ELEVENLABS
}

// FREE (default) uses the bundled edge-tts community engine — no key,
// no cost, works out of the box. BYOK routes narration through
// whichever of OPENAI/ELEVENLABS credential the company has saved
// instead — an explicit opt-in rather than the implicit
// "BYOK-wins-automatically" pattern text/image providers use, because
// unlike those, picking BYOK here can incur real per-generation cost
// even though a key might already exist for another capability.
enum VoiceEngine {
  FREE
  BYOK
}

// BYOK storage, one row per (company, vendor) — not per capability. A
// company's OpenAI key covers both text (Phase 2) and image generation
// (Phase 3's AI background provider) since it's the same vendor
// account. encryptedKey is AES-256-GCM ciphertext (see
// src/lib/crypto.ts) — the plaintext key is never stored, logged, or
// sent to the client after save; the UI only ever shows a masked
// preview. Never touch this table without going through
// src/lib/actions/provider-credentials.ts.
model ProviderCredential {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider     AiProviderKind
  encryptedKey String
  // Last 4 characters of the real key, kept in plaintext so the UI can
  // show "sk-...ab12" without ever decrypting the stored credential.
  keyPreview   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider])
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
}

// A connected Facebook Page or Instagram Business account. externalAccountId
// is the Page ID (FACEBOOK) or IG Business Account ID (INSTAGRAM) — never a
// personal profile, per Meta's Page/Business-only publishing model.
// accessToken is the long-lived (60-day) Page access token, AES-256-GCM
// encrypted exactly like ProviderCredential.encryptedKey — never stored or
// logged in plaintext, never sent to the client after connect. Only ever
// touch this table through src/lib/actions/social-accounts.ts.
model SocialAccount {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  platform          SocialPlatform
  externalAccountId String
  displayName       String
  encryptedToken    String
  tokenExpiresAt    DateTime

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publishJobs PublishJob[]

  @@unique([companyId, platform, externalAccountId])
  @@index([companyId])
}

// The four providers verified against real, current, publicly-documented
// APIs and pricing before this enum was written (see the "Provider
// Reality Check" done ahead of this migration). Only ZERNIO has a real
// adapter (src/lib/providers/aggregator/zernio-adapter.ts) built against
// verified request/response shapes from docs.zernio.com — the other
// three are real, existing products but their exact API request/response
// schemas weren't fetchable with enough confidence to code against
// safely, so their adapters throw a "Coming soon" AggregatorProviderError
// rather than faking a call. See src/lib/providers/aggregator/resolver.ts.
enum SocialAggregatorProvider {
  ZERNIO
  POSTPROXY
  UPLOAD_POST
  BUFFER
}

// BYOK storage for a social-aggregator API key, one row per (company,
// provider) — same shape and same AES-256-GCM encryption as
// ProviderCredential, kept as a separate model because these are a
// different category of credential (third-party publishing routers, not
// AI generation vendors) with their own per-platform account mapping.
// Never touch this table without going through
// src/lib/actions/aggregator-credentials.ts.
model AggregatorCredential {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider     SocialAggregatorProvider
  encryptedKey String
  keyPreview   String
  // Maps this app's SocialPlatform values (e.g. "FACEBOOK") to the
  // account ID the aggregator itself assigned when the user connected
  // that account on the aggregator's own dashboard — e.g. Zernio's
  // 24-character accountId. The aggregator, not this app, owns that
  // connection; this is just the pointer to it. Record<string, string>.
  accountMap Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider])
}

// Append-only audit log of "Publish via Selected Provider" attempts from
// a campaign card — deliberately not a retry/backoff queue table like
// PublishJob or CampaignItem, since this button is a single synchronous
// user-triggered attempt, not a scheduled job; a full queue here would be
// unused machinery. Kept even on failure so the card can show real
// publish history, and kept forever (never deleted by cleanup) so it
// remains real audit history after the source file is gone.
model AggregatorPublishLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaignItemId String
  campaignItem   CampaignItem @relation(fields: [campaignItemId], references: [id], onDelete: Cascade)

  provider       SocialAggregatorProvider
  succeeded      Boolean
  externalPostId String?
  errorMessage   String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([campaignItemId])
}

enum PublishStatus {
  DRAFT // created, not yet queued
  SCHEDULED // queued for a future scheduledFor time
  PUBLISHING // a job is actively attempting the publish call
  PUBLISHED // confirmed live — externalPostId/externalPostUrl are set
  FAILED // exhausted retries — needs a manual retry after the underlying issue is fixed
}

// One attempt to publish an existing Poster to a connected SocialAccount.
// Retry/backoff bookkeeping mirrors CampaignItem (Phase 5) — same reasoning:
// one job type, so a dedicated queue table would be premature. posterId is
// SetNull (not Cascade) because losing the source poster shouldn't erase a
// job's publish history/errorMessage.
model PublishJob {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  posterId        String?
  poster          Poster?       @relation(fields: [posterId], references: [id], onDelete: SetNull)

  caption      String
  status       PublishStatus @default(DRAFT)
  scheduledFor DateTime?

  externalPostId  String?
  externalPostUrl String?

  errorMessage  String?
  retryCount    Int      @default(0)
  nextAttemptAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagementSnapshots EngagementSnapshot[]

  @@index([companyId])
  @@index([status, nextAttemptAt])
}

// One pull's worth of real platform engagement for a PUBLISHED
// PublishJob — appended daily (pull-engagement.ts), not updated in
// place, so a real trend is visible rather than only the latest number.
// Only ever populated from a real Graph API call (SocialProvider.
// getEngagement) — never estimated or backfilled.
model EngagementSnapshot {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publishJobId String
  publishJob   PublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)

  likes    Int
  comments Int
  shares   Int
  // Instagram-only — Meta deprecated "impressions" for media created
  // after 2024-07-02; "reach" is the current supported metric. Null for
  // Facebook Page posts, which don't expose this figure the same way.
  reach Int?

  fetchedAt DateTime @default(now())

  @@index([companyId])
  @@index([publishJobId])
}

// A short-lived, unguessable, UNAUTHENTICATED public URL for exactly one
// MediaAsset — created only immediately before a publish attempt and
// deleted/expired right after. This exists solely because Instagram's
// Graph API media-container endpoint (POST /{ig-id}/media) requires a
// publicly-fetchable image_url and cannot accept a direct binary upload,
// unlike every other route in this app (which all require a session — see
// src/app/api/storage/[...key]/route.ts). Never widen this token's
// lifetime or scope "for convenience" — it is a deliberate, narrow
// exception to CLAUDE.md's data-isolation rule, not a general-purpose
// public file host.
model PublicAssetLink {
  id           String     @id @default(cuid())
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([token])
}
