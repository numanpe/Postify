# PostgreSQL connection used by Prisma.
# Local dev default matches docker-compose.yml. DIRECT_URL is only
# needed for pooled providers (e.g. Neon) where migrations must bypass
# the pooler — for a plain Postgres instance like this one, both point
# at the same database.
DATABASE_URL="postgresql://postify:postify@localhost:5432/postify?schema=public"
DIRECT_URL="postgresql://postify:postify@localhost:5432/postify?schema=public"

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth app credentials for "Continue with Google" (Part B1).
# Get these from console.cloud.google.com (APIs & Services > Credentials
# > Create OAuth client ID > Web application). The provider is only
# registered in auth.ts when both are set — until then, the Google
# button is simply absent rather than shown-but-broken. Register BOTH
# of these exact Authorized redirect URIs on the OAuth client:
#   https://ipostify.vercel.app/api/auth/callback/google  (production)
#   http://localhost:3000/api/auth/callback/google        (local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encrypts per-company BYOK provider API keys at rest (AES-256-GCM, see
# src/lib/crypto.ts). Must decode to exactly 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""

# BYOK provider keys (OpenAI/Anthropic) are supplied per-company via the
# Settings page and stored encrypted in ProviderCredential — not set here
# as env vars. The app has no shared/default provider key; the free
# path (src/lib/providers/text/template-provider.ts) needs none.

# Authenticates external scheduler calls to
# /api/jobs/process-campaign-items (e.g. a Vercel Cron entry). Optional
# in local dev — the fire-and-forget trigger and the manual "Process
# now" button work without it; without CRON_SECRET set, the route
# refuses all requests rather than running unauthenticated.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=""

# Publicly reachable base URL for this deployment, no trailing slash
# (e.g. https://postify.example.com). Required for Phase 6 publishing:
# Meta's OAuth callback and Instagram's image-fetch requirement
# (src/lib/public-asset-links.ts) both need a real HTTPS URL Meta's
# servers can reach — localhost will not work for either.
APP_URL=""

# Meta Developer app credentials for the Facebook/Instagram publishing
# connect flow (the "Authenticate and request data from users with
# Facebook Login" use case, with pages_show_list/pages_read_engagement/
# pages_manage_posts/instagram_basic/instagram_content_publish requested
# via scope). Get these from developers.facebook.com — see
# src/lib/providers/social/.
META_APP_ID=""
META_APP_SECRET=""

# LinkedIn Developer app credentials for the LinkedIn Page publishing
# connect flow (w_organization_social + r_organization_admin scopes).
# Get these from developer.linkedin.com. Posting to a real Organization
# page also requires LinkedIn's own Community Management API product
# approval — see REQUIRES_APP_REVIEW in
# src/lib/providers/social/platform-status.ts. Without approval, the
# OAuth flow and API calls still work for verification, but the
# platform itself blocks the post from reaching a real audience.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# TikTok Developer app credentials for the TikTok Content Posting API
# (video.publish scope). Get these from developers.tiktok.com. Until
# Postify's TikTok app passes their audit, TikTok forces every post to
# SELF_ONLY (private) visibility — see platform-status.ts. Same
# "works today, gated by the platform" situation as LinkedIn above.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Platform-wide transactional email (password reset, admin invites) via
# Resend — src/lib/email.ts. Get an API key from resend.com. Without a
# verified domain (resend.com/domains), RESEND_FROM_EMAIL falls back to
# Resend's onboarding@resend.dev sandbox address, which their docs state
# is for testing only — real delivery to arbitrary recipients needs a
# verified domain and a from-address on it set here.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Upstash Redis credentials for login/signup/password-reset rate
# limiting (src/lib/rate-limit.ts). Provision via the Vercel Marketplace
# (`vercel integration add upstash/upstash-kv`, auto-injects these) or
# upstash.com directly. Without these set, the app still works — rate
# limiting fails open (logs a warning, allows the request through)
# rather than locking everyone out.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Platform-held Gemini API key powering the zero-setup "Free AI" text
# pool (src/lib/providers/text/shared-pool.ts) — a shared,
# first-come-first-serve upgrade over the plain template for every
# free-tier company with no BYOK key of their own, never exposed
# client-side. Distinct from any company's own BYOK Gemini
# ProviderCredential. Get one from aistudio.google.com/apikey the same
# way a BYOK Gemini key is obtained — just don't enable billing on this
# project, since the whole point is using its genuine free/unpaid tier.
# Without this set, free-tier companies simply get the template
# provider, same as before this feature existed — never a broken state.
PLATFORM_GEMINI_API_KEY=""

# Platform-held Cloudflare Workers AI credentials powering the
# zero-setup "AI Background" image pool for posters
# (src/lib/providers/image/shared-image-pool.ts) — replaced the old
# Pollinations fallback entirely (real 10,000-neuron/day free tier, no
# card required, confirmed directly against developers.cloudflare.com;
# see free-ai-plan.md's Cloudflare investigation). Get an Account ID
# from the Cloudflare dashboard sidebar and an API token from My
# Profile > API Tokens > Create Token (Workers AI:Edit permission is
# enough — no need for account-listing/broader scopes). Without these
# set, "AI Background" falls back straight to the brand gradient, same
# as before this feature existed — never a broken state.
PLATFORM_CLOUDFLARE_ACCOUNT_ID=""
PLATFORM_CLOUDFLARE_API_TOKEN=""

# Cloudflare Turnstile CAPTCHA for the signup form
# (src/components/auth/signup-form.tsx, src/lib/turnstile.ts). Get a
# free site from dash.cloudflare.com/?to=/:account/turnstile. The site
# key needs the NEXT_PUBLIC_ prefix to reach the browser. Without these
# set, signup works with no CAPTCHA gate — never a broken state.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
