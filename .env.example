# PostgreSQL connection used by Prisma.
# Local dev default matches docker-compose.yml. DIRECT_URL is only
# needed for pooled providers (e.g. Neon) where migrations must bypass
# the pooler — for a plain Postgres instance like this one, both point
# at the same database.
DATABASE_URL="postgresql://postify:postify@localhost:5432/postify?schema=public"
DIRECT_URL="postgresql://postify:postify@localhost:5432/postify?schema=public"

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=""

# Encrypts per-company BYOK provider API keys at rest (AES-256-GCM, see
# src/lib/crypto.ts). Must decode to exactly 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""

# BYOK provider keys (OpenAI/Anthropic) are supplied per-company via the
# Settings page and stored encrypted in ProviderCredential — not set here
# as env vars. The app has no shared/default provider key; the free
# path (src/lib/providers/text/template-provider.ts) needs none.

# Authenticates external scheduler calls to
# /api/jobs/process-campaign-items (e.g. a Vercel Cron entry). Optional
# in local dev — the fire-and-forget trigger and the manual "Process
# now" button work without it; without CRON_SECRET set, the route
# refuses all requests rather than running unauthenticated.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=""

# Publicly reachable base URL for this deployment, no trailing slash
# (e.g. https://postify.example.com). Required for Phase 6 publishing:
# Meta's OAuth callback and Instagram's image-fetch requirement
# (src/lib/public-asset-links.ts) both need a real HTTPS URL Meta's
# servers can reach — localhost will not work for either.
APP_URL=""

# Meta Developer app credentials (Facebook Login + Pages API products,
# Business app type) for the Facebook/Instagram publishing connect flow.
# Get these from developers.facebook.com — see src/lib/providers/social/.
META_APP_ID=""
META_APP_SECRET=""
